# Copy to .dev.vars for `wrangler dev`. In production, set these with `wrangler secret put NAME`.
# Any one model provider is enough.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# Optional: web search for agents (one of these).
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# Optional: require this token for /api requests (set it in the editor's agent settings too).
# EDITOR_TOKEN=

# Optional: a scripted model for trying the agent loop without keys.
# DEMO_MODEL=1
