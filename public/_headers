# Cloudflare static asset headers. API responses get theirs in worker/index.ts.
# The build (securityHeaders in vite.config.ts) replaces __SCRIPT_HASHES__ with
# the hashes of index.html's inline scripts. See THREAT_MODEL.md for why each
# policy is what it is.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Reporting-Endpoints: default="/api/reports", csp="/api/reports"
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), clipboard-read=(), clipboard-write=(self), display-capture=(), encrypted-media=(), fullscreen=(self), gamepad=(), geolocation=(), gyroscope=(), hid=(), identity-credentials-get=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(self), midi=(), otp-credentials=(), payment=(), picture-in-picture=(), publickey-credentials-create=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), storage-access=(), sync-xhr=(), usb=(), window-management=(), xr-spatial-tracking=()
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' __SCRIPT_HASHES__; style-src 'self'; img-src 'self' data: blob: https: http://localhost:* http://127.0.0.1:*; font-src 'self'; connect-src 'self' https: wss: ws://localhost:* http://localhost:* http://127.0.0.1:*; frame-src 'self' https: http://localhost:* http://127.0.0.1:*; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; require-trusted-types-for 'script'; report-uri /api/reports; report-to csp

# The service worker and manifest must be revalidated on every check, or an
# update can sit unseen behind a cached copy. Built files have hashed names.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Extension workers. Each extension's code is a blob: module the worker imports,
# so script-src allows only blob:. The sandboxed one has no network at all. The
# page's report-only policy doesn't fit a worker, so it is dropped here.
/extension-worker/sandboxed.js
  Cache-Control: no-cache
  ! Content-Security-Policy-Report-Only
  Content-Security-Policy: default-src 'none'; script-src blob:
/extension-worker/network.js
  Cache-Control: no-cache
  ! Content-Security-Policy-Report-Only
  Content-Security-Policy: default-src 'none'; script-src blob:; connect-src https: wss: http://localhost:* ws://localhost:*

# Extension panels: the extension's own page, in an iframe sandboxed without
# allow-same-origin. Inline script and style are the point of a panel, so it
# gets its own policy in place of the page's: no fetch(), no frames, and it can
# only be framed by the editor.
/extension-panel
  Cache-Control: no-cache
  ! Content-Security-Policy
  ! Content-Security-Policy-Report-Only
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline' https:; img-src data: blob: https:; font-src data: https:; media-src data: blob: https:; form-action 'none'; base-uri 'none'; frame-ancestors 'self'

/.well-known/traffic-advice
  Content-Type: application/trafficadvice+json
