{
  "name": "markdown-editor",
  "version": "1.0.0",
  "description": "Local-first markdown editor for Hugo blogs, hosted on Cloudflare",
  "scripts": {
    "registries": "node scripts/registries.mjs",
    "predev": "npm run registries",
    "dev": "vite",
    "prebuild": "npm run registries",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "pretypecheck": "npm run registries",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "pretest": "npm run registries",
    "test": "vitest run",
    "predev:worker": "npm run registries",
    "dev:worker": "wrangler dev --port 8787",
    "gate": "bash scripts/fast-gate.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PaulKinlan/MarkdownEdiitor.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/PaulKinlan/MarkdownEdiitor/issues"
  },
  "homepage": "https://github.com/PaulKinlan/MarkdownEdiitor#readme",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@earendil-works/chord": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-durable": "^1.4.0",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "idb-keyval": "^6.3.0",
    "lit": "^3.3.3",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/wicg-file-system-access": "^2023.10.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "private": true,
  "type": "module",
  "overrides": {
    "undici": "^7.30.1"
  }
}
