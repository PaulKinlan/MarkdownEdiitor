{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["wicg-file-system-access", "@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "isolatedModules": true
  },
  "include": ["src", "worker", "tests"],
  // The service worker has its own config: the WebWorker and DOM libs clash.
  "exclude": ["src/sw"]
}
